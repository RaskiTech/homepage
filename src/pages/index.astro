---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogList from '../components/BlogList.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div>
				<p>
					This is Rasmus Kirvesmäki's website. I am a software developer currently studying at Aalto University. Here I write about stuff that I've worked with 
					that might be also interesting to other people.
				</p>
			</div>
			<hr class="divider"/>

			<section style="margin-top: 3em;">
				<h4 style="margin-bottom: 1em;">Posts</h4>
				<BlogList/>
			</section>

		</main>
		<Footer />
	</body>
</html>
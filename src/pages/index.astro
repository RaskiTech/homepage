---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogList from '../components/BlogList.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h3>RaskiTech</h3>
			<p>
				Hi, I'm Rasmus Kirvesmäki - A software developer currently studying at Aalto University. Here I write about stuff that I've worked with 
				that might be also interesting to other people.
			</p>

			<p>
				For now this site is a work in progress, but hopefully not for long.
			</p>

			<section style="margin-top: 5em">
				<BlogList/>
			</section>

		</main>
		<Footer />
	</body>
</html>
